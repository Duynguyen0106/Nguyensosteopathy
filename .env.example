# Public booking URLs for Nguyen's Osteopathic Clinic
# Defaults point at the live domain book page + Treow embed.
NEXT_PUBLIC_BOOKING_URL=https://www.nguyensosteopathy.com/book
NEXT_PUBLIC_BOOKING_EMBED_URL=https://treow-clinic.vercel.app/embed/nguyens-osteopathy

# Google Places (server-only — never prefix with NEXT_PUBLIC_)
# Enable "Places API (New)" + billing, restrict key by API only (not HTTP referrers).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=Nguyen's Osteopathic Clinic 52 Powis Street Woolwich SE18
