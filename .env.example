# Public booking URLs for Nguyen's Osteopathic Clinic
# Defaults point at the live domain book page + Treow (Cloudflare Workers) embed / public book.
NEXT_PUBLIC_BOOKING_URL=https://www.nguyensosteopathy.com/book
NEXT_PUBLIC_TREOW_APP_ORIGIN=https://treow-clinic.duydichdanh.workers.dev
NEXT_PUBLIC_BOOKING_EMBED_URL=https://treow-clinic.duydichdanh.workers.dev/embed/nguyens-osteopathy
NEXT_PUBLIC_BOOKING_EXTERNAL_URL=https://treow-clinic.duydichdanh.workers.dev/book/nguyens-osteopathy

# Optional analytics (loaded only after cookie-banner “Accept analytics”)
# Set as Cloudflare Worker secrets / vars — Measurement ID looks like G-XXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Google Places (server-only — never prefix with NEXT_PUBLIC_)
# Required for live review cards on / and /reviews.
# Setup (Google Cloud):
# 1. Enable "Places API (New)" and billing on the project.
# 2. Create an API key restricted to Places API (New) only (IP / none — not HTTP referrers).
# 3. Add the same key in Cloudflare → Workers → nguyensosteopathy → Settings → Variables
#    (or `.dev.vars` locally for `npm run preview`).
GOOGLE_PLACES_API_KEY=
# Nguyen's Osteopathic Clinic — St James Pharmacy, Woolwich
GOOGLE_PLACE_ID=ChIJG4dhhJip2EcRVmEEenyYD8E
GOOGLE_PLACE_QUERY=Nguyen's Osteopathic Clinic 52 Powis Street Woolwich SE18
