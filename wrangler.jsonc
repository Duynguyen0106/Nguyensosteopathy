{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nguyensosteopathy",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Builds deploy/preview runs wrangler. Always produce the OpenNext
  // worker bundle here so a blank or plain `next build` Build command still works.
  "build": {
    "command": "npm run cf:build"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Required for Workers Builds PR previews (`npx wrangler preview`).
  // Empty = inherit top-level assets/compat; do not put production routes here.
  "previews": {},
  // Preview URL already referenced in next.config allowedDevOrigins
  "workers_dev": true,
  // Custom domains (zone already on Cloudflare DNS). Attach/confirm in
  // Workers & Pages → nguyensosteopathy → Settings → Domains.
  "routes": [
    { "pattern": "www.nguyensosteopathy.com", "custom_domain": true },
    { "pattern": "nguyensosteopathy.com", "custom_domain": true }
  ],
  // ISR / SSG incremental cache for OpenNext (acupuncture corpus + other SSG).
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "nguyensosteopathy-next-cache"
    }
  ]

  // Dashboard (outer) layer for scrapers — enable in Cloudflare zone:
  //   Security → Bots → Bot Fight Mode (or Super Bot Fight Mode)
  //   Security → WAF → Rate limiting rules for likely-automated traffic
  // In-Worker defence lives in src/middleware.ts + src/lib/anti-scrape.ts.
}
